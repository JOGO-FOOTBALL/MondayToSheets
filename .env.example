# Copy to .env and fill in. Never commit .env.

# --- Azure: used to read secrets from Key Vault (same service principal as the Airflow DAGs) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_VAULT_URL=https://ds433kv.vault.azure.net/

# --- Run mode: true = sync once and exit (Airflow); false = loop every SYNC_INTERVAL_SECONDS ---
RUN_ONCE=true
# SYNC_INTERVAL_SECONDS=600

# --- Optional: set these to skip Key Vault (otherwise read from MondayApiToken /
#     MondayToSheetsGoogleServiceAccount in Key Vault) ---
# MONDAY_API_TOKEN=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# --- Optional overrides (defaults in src/config.py) ---
# MONDAY_BOARD_ID=18437648212
# SPREADSHEET_ID=1tjCpL-27djrMfVj4DTzosXvCWIn9e5VkfqonVEHE_-c
# SHEET_TAB=Monday
